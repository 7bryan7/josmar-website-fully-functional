# Active Provider ('supabase' or 'cloudflare')
PROVIDER=supabase

# Supabase Database (Direct connection string for serverless functions)
# Format: postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres

# Supabase Client API Configuration
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=josmar-media

# Supabase Auth Security
# The JWT secret is available in your Supabase Dashboard under API Settings
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_key_here
